{
  "name": "resume",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p typecheck \"build-only {@}\" --",
    "preview": "vite preview",
    "deploy": "bun run build && cf deploy --prebuilt",
    "deploy:check": "bun run build && cf deploy --prebuilt --dry-run",
    "build-only": "vite build",
    "typecheck": "vue-tsc --build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@comark/html": "^0.8.1",
    "@comark/vue": "^0.8.1",
    "@nuxt/ui": "^4.12.0",
    "@tailwindcss/vite": "^4.3.3",
    "tailwind-variants": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.6.0-rc.14",
    "vue-to-print": "^1.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@iconify-json/lucide": "^1.2.149",
    "@iconify/vue": "^5.0.4",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "cf": "1.0.0-beta.26",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.75.0",
    "oxlint": "~1.90.0",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "@vue/compat": "rc",
    "@vue/compiler-core": "rc",
    "@vue/compiler-dom": "rc",
    "@vue/compiler-sfc": "rc",
    "@vue/compiler-ssr": "rc",
    "@vue/compiler-vapor": "rc",
    "@vue/reactivity": "rc",
    "@vue/runtime-core": "rc",
    "@vue/runtime-dom": "rc",
    "@vue/runtime-vapor": "rc",
    "@vue/server-renderer": "rc",
    "@vue/shared": "rc",
    "vue": "rc"
  }
}
